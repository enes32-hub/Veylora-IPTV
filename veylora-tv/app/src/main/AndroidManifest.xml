<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET, ACCESS_NETWORK_STATE, FOREGROUND_SERVICE, FOREGROUND_SERVICE_DATA_SYNC and
         POST_NOTIFICATIONS are declared by :core, together with WorkManager's foreground-service
         host: core is what does the networking and runs the sync/download worker. They merge in
         from there — see core/src/main/AndroidManifest.xml. -->

    <!-- MODIFY_AUDIO_SETTINGS is declared by :player-core, which owns VolumeBoost. -->

    <!-- Android TV provider writes for Watch Next cards. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <!-- User-selected documents use SAF grants; TV fallback stays in app-owned storage. -->

    <!-- TV-first app, but allow non-TV installs too: touchscreen optional, and leanback is NOT required
         (required=true blocked plain phones / non-TV armv7a boxes that don't report the leanback feature). -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name=".OwnTVApp"
        android:allowBackup="false"
        android:banner="@drawable/veylora_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/veylora_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/veylora_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.OwnTV"
        android:usesCleartextTraffic="true"
        tools:targetApi="26">

        <!-- Exposes the downloaded update APK to the system installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Disable WorkManager default auto-init; OwnTVApp provides Configuration. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- One launcher activity per icon colour (core's AppIcon); AppIconSwitcher keeps exactly one
             enabled. MainActivity is the default (Eggshell) and keeps its name, so an icon placed before this change still
             opens the app. Each carries its own icon, banner and launch-screen theme, and ALL intent
             filters: a disabled activity resolves nothing, so the owntv:// links always reach the enabled
             one. LEANBACK_LAUNCHER shows it on TV launchers; LAUNCHER on phone/tablet/box home screens. -->
        <activity
            android:name=".MainActivityPetrol"
            android:banner="@drawable/veylora_banner"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/veylora_app_icon"
            android:launchMode="singleTop"
            android:roundIcon="@mipmap/veylora_app_icon"
            android:theme="@style/Theme.OwnTV.Starting.Petrol"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="play"
                    android:scheme="owntv" />
                <data
                    android:host="open"
                    android:scheme="owntv" />
            </intent-filter>
        </activity>

